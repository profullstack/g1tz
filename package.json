{
  "name": "@profullstack/g1tz",
  "version": "0.3.0",
  "description": "A git TUI that shows you the repository, not a menu of git commands. Teams: organizations, roles, seats, shared workspaces.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/profullstack/g1tz",
  "bin": {
    "g1tz": "./bin/g1tz.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=22.6"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:server": "bun server/server.ts",
    "build": "bun x tsc -p tsconfig.json",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit && bun x tsc -p server/tsconfig.json",
    "test": "bun test test server/test",
    "test:tui": "bun test test",
    "test:server": "bun test server/test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@profullstack/hqtui": "^0.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "lazygit",
    "hqtui",
    "pulse",
    "github",
    "activity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/g1tz.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
